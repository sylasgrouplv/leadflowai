# LeadFlow AI — environment variables
# Copy to .env and adjust. Bun auto-loads .env at startup.

# --- Database ---------------------------------------------------------------
# SQLite (default). Path is relative to the site root.
DATABASE_PATH=.data/leadflow.db
# To run on Postgres later, set DATABASE_URL and follow the notes in
# src/server/db/client.ts (driver + dialect swap; schema is already portable).
# DATABASE_URL=postgres://user:pass@host:5432/db

# --- Auth -------------------------------------------------------------------
# Long random string. If unset, a secret is generated and persisted in
# .data/.session_secret (survives restarts, unique per sandbox).
SESSION_SECRET=

# --- Integration providers (mock is the default) ----------------------------
# Swap a provider by implementing the class behind the same interface in
# src/server/integrations/<name>.ts and flipping the env var here.
AI_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
CALENDAR_PROVIDER=mock
CRM_PROVIDER=mock
STRIPE_PROVIDER=mock
